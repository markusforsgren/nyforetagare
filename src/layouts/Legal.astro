---
import Base from './Base.astro';
interface Props { title: string; updated: string; description?: string }
const { title, updated, description } = Astro.props;
---
<Base title={title} description={description}>
  <article class="article legal">
    <h1>{title}</h1>
    <p class="muted" style="margin:0 0 8px">Senast uppdaterad: {updated}</p>
    <nav class="legal-nav" aria-label="Juridisk information">
      <a href="/anvandarvillkor/">Användarvillkor</a>
      <a href="/integritetspolicy/">Integritetspolicy</a>
      <a href="/cookies/">Cookies</a>
    </nav>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
