---
import Base from '../../layouts/Base.astro';
import { LAN } from '../../config';
import LanPicker from '../../components/LanPicker.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const count = (slug: string) => posts.filter((p) => p.data.lan === slug).length;
---
<Base title="Nyföretagare i ditt län" description="Lokala nyheter, företagare och tjänster i ditt län. Sök på din kommun.">
  <div class="wrap page-head stack">
    <span class="eyebrow">Lokalt</span>
    <h1>Nyföretagare i ditt län</h1>
    <p class="lead" style="margin:0">Sök på din kommun eller välj län för att se lokala nyheter, företag och tjänster nära dig.</p>
    <div style="max-width:560px"><LanPicker id="lan-sok" /></div>
  </div>
  <div class="wrap lan-grid" style="padding-bottom:64px">
    {LAN.map((l) => (
      <a href={`/lan/${l.slug}/`}>
        <span class="n">{l.name}</span>
        <span class="c">{count(l.slug) > 0 ? `${count(l.slug)} artiklar` : l.redaktor ? `Ansvarig: ${l.redaktor}` : 'Söker lokal partner'}</span>
      </a>
    ))}
  </div>
</Base>
