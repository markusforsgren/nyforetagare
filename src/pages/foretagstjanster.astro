---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES } from '../config';
import { getCompanies, asService } from '../lib/companies';

const dbServices = (await getCompanies()).filter((c) => c.tjanstekategori).map(asService);
const services = [...SERVICES, ...dbServices].sort((a, b) => Number(b.utvald) - Number(a.utvald));
const categories = [...new Set(services.map((s) => s.category))];
---
<Base title="Företagstjänster" description="Hitta leverantörer som är vana vid nystartade företag.">
  <div class="wrap page-head stack">
    <span class="eyebrow">Företagstjänster</span>
    <h1>Hitta rätt hjälp för ditt företag</h1>
    <p class="lead" style="margin:0">Hemsida, redovisning, marknadsföring och mer. Här listas medlemmar som säljer tjänster till andra företag.</p>
    <p class="muted" style="margin:0">Alla medlemmar kan synas här – välj vilken tjänst du erbjuder i din profil. Vill du se alla medlemsföretag? <a href="/foretag/">Till företagskatalogen →</a></p>
    <div class="chips">{categories.map((c) => <span>{c}</span>)}</div>
  </div>
  <div class="wrap grid" style="padding-bottom:56px">
    {services.map((s) => <ServiceCard s={s} />)}
  </div>
  <section class="soft">
    <div class="wrap section split">
      <div class="stack">
        <h2 class="h2">Erbjuder du tjänster till företagare?</h2>
        <p class="lead" style="margin:0">Bli medlem gratis, välj vilken tjänst du erbjuder i din profil och syns här för företagare som letar efter hjälp.</p>
      </div>
      <div><a href="/foretag/konto/" class="btn btn-dark">Bli medlem – gratis</a></div>
    </div>
  </section>
</Base>
