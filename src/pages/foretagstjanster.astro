---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES } from '../config';

const services = [...SERVICES].sort((a, b) => Number(b.utvald) - Number(a.utvald));
const categories = [...new Set(services.map((s) => s.category))];
---
<Base title="Företagstjänster" description="Hitta leverantörer som är vana vid nystartade företag.">
  <div class="wrap page-head stack">
    <span class="eyebrow">Företagstjänster</span>
    <h1>Hitta rätt hjälp för ditt företag</h1>
    <p class="lead" style="margin:0">Hemsida, redovisning, marknadsföring och mer. Leverantörer som är vana vid nystartade.</p>
    <div class="chips">{categories.map((c) => <span>{c}</span>)}</div>
  </div>
  <div class="wrap grid" style="padding-bottom:56px">
    {services.map((s) => <ServiceCard s={s} />)}
  </div>
  <section class="soft">
    <div class="wrap section split">
      <div class="stack">
        <h2 class="h2">Erbjuder du tjänster till företagare?</h2>
        <p class="lead" style="margin:0">Bli listad här och nå nystartade som letar efter hjälp.</p>
      </div>
      <div><a href="/lista-ditt-foretag/" class="btn btn-dark">Anmäl ditt företag</a></div>
    </div>
  </section>
</Base>
