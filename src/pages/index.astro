---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import LanPicker from '../components/LanPicker.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getPosts, formatDate } from '../lib/posts';
import { getCompanies, asService } from '../lib/companies';
import CompanyCard from '../components/CompanyCard.astro';
import { SERVICES, FEATURED_COMPANIES, categoryName, TEXTER } from '../config';
const T = TEXTER.startsida;

const posts = await getPosts();
const top = posts.find((p) => p.data.toppnyhet) ?? posts[0];
const rest = posts.filter((p) => p !== top);
const latest = rest.slice(0, 5);
const more = rest.slice(5, 8).length ? rest.slice(5, 8) : rest.slice(0, 3);
const companies = await getCompanies();
// Utvalda företag först, sedan de senast uppdaterade
const focus = [...companies].sort((a, b) => Number(b.utvald) - Number(a.utvald) || b.updated_at.localeCompare(a.updated_at)).slice(0, 3);
// Rullande remsa: senaste artiklar och nya medlemsföretag, nyast först
const ticker = [
  ...posts.slice(0, 8).map((p) => ({ typ: 'Artikel', text: p.data.title, href: `/artiklar/${p.id}/`, d: p.data.datum.toISOString() })),
  ...[...companies].sort((a, b) => b.updated_at.localeCompare(a.updated_at)).slice(0, 6)
    .map((c) => ({ typ: 'Nytt företag', text: `${c.namn}${c.ort ? ', ' + c.ort : ''}`, href: `/foretag/${c.slug}/`, d: c.updated_at })),
].sort((a, b) => b.d.localeCompare(a.d)).slice(0, 12);
const stats = [
  { n: posts.length, t: 'artiklar' },
  { n: companies.length, t: 'medlemsföretag' },
  { n: 21, t: 'län' },
].filter((x) => x.n >= 5); // små siffror visas inte
const services = [
  ...SERVICES.filter((s) => s.utvald),
  ...companies.filter((c) => c.tjanstekategori).map(asService),
  ...SERVICES.filter((s) => !s.utvald),
].slice(0, 3);
---
<Base>
  <!-- Rullande remsa med det senaste -->
  {ticker.length > 0 && (
    <div class="ticker" aria-label="Senaste nytt">
      <span class="ticker-label">Senaste</span>
      <div class="ticker-view">
        <ul class="ticker-track" style={`--dur:${Math.max(60, ticker.length * 15)}s`}>
          {[...ticker, ...ticker].map((t, i) => (
            <li aria-hidden={i >= ticker.length ? 'true' : undefined}>
              <a href={t.href} tabindex={i >= ticker.length ? -1 : undefined}><b>{t.typ}</b>{t.text}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <!-- Toppnyhet + senaste -->
  {top && (
    <section class="wrap hero">
      <article class="hero-main">
        <img src={top.data.bild ?? TEXTER.allmant.standardbild} alt={top.data.title} />
        <span class="tag" style="align-self:flex-start">{categoryName(top.data.kategori)}</span>
        <h1><a href={`/artiklar/${top.id}/`}>{top.data.title}</a></h1>
        <p class="lead" style="margin:0">{top.data.ingress}</p>
        <p class="muted" style="margin:0">Av {top.data.skribent} · {formatDate(top.data.datum)}</p>
      </article>
      <aside class="latest">
        <h2>Senaste</h2>
        {latest.map((p) => (
          <a href={`/artiklar/${p.id}/`}>
            <span class="cat">{categoryName(p.data.kategori)}</span>
            <span class="t">{p.data.title}</span>
          </a>
        ))}
        {latest.length === 0 && <p class="muted">Fler artiklar kommer snart.</p>}
      </aside>
    </section>
  )}

  <!-- Toppsektion med rörlig bakgrund -->
  <section class="intro" aria-label="Om Nyföretagare">
    <div class="intro-bg" aria-hidden="true">
      <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span><span class="blob b4"></span>
    </div>
    <div class="wrap intro-inner">
      <div class="intro-text">
        <span class="intro-eyebrow">{T.etikett}</span>
        <h1 class="intro-title">{T.rubrik} <span class="hl">{T.rubrik_markerad}</span></h1>
        <p class="intro-lead">{T.ingress}</p>
        <ul class="intro-stats">
          {stats.map((x) => <li><strong>{x.n}</strong><span>{x.t}</span></li>)}
        </ul>
        <div class="intro-cta">
          <a href="/om-oss/" class="btn btn-bright" data-umami-event="Så funkar (startsida)">{T.knapp1}</a>
          <a href="/foretag/konto/" class="btn btn-ghost" data-umami-event="Bli medlem (startsida)">{T.knapp2}</a>
        </div>
      </div>
      <div class="intro-mark" aria-hidden="true">
        <span class="mark-glow"></span>
        <img src="/img/mark.png" alt="" width="400" height="320" />
      </div>
    </div>
  </section>

  <!-- Lokalt -->
  <section class="wrap section split">
    <img src={T.lokal_bild} alt={T.lokal_rubrik} style="border-radius:12px;max-width:620px" loading="lazy" />
    <div class="stack">
      <span class="eyebrow">{T.lokal_etikett}</span>
      <h2 class="h2">{T.lokal_rubrik}</h2>
      <p class="lead" style="margin:0">{T.lokal_text}</p>
      <LanPicker id="lan-val-start" />
      <a href="/lokal-partner/" style="font-weight:600">Vill du driva Nyföretagare i ditt län? Bli lokal partner →</a>
    </div>
  </section>

  <!-- Företagare i fokus -->
  <section class="soft">
    <div class="wrap section">
      <div class="section-head">
        <div>
          <h2 class="h2">{T.fokus_rubrik}</h2>
          <p class="muted" style="margin:6px 0 0;font-size:16px">{T.fokus_text}</p>
        </div>
      </div>
      <div class="grid">
        {focus.length > 0
          ? focus.map((c) => <CompanyCard c={c} />)
          : FEATURED_COMPANIES.map((f) => (
            <article class="card">
              <div class="logo-ph">Logga</div>
              <h3>{f.name}</h3>
              <span class="meta">{f.meta}</span>
              <p>{f.text}</p>
            </article>
          ))}
        <article class="card dark">
          <h3 style="font-size:22px">{T.fokus_cta_rubrik}</h3>
          <p>{T.fokus_cta_text}</p>
          <a href="/foretag/konto/" class="btn btn-bright push">Bli medlem – gratis</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Företagstjänster -->
  <section class="wrap section" style="display:flex;flex-wrap:wrap;gap:40px">
    <div class="stack" style="flex:1 1 320px;min-width:0">
      <span class="eyebrow">{T.tjanster_etikett}</span>
      <h2 class="h2">{T.tjanster_rubrik}</h2>
      <p class="lead" style="margin:0">{T.tjanster_text}</p>
      <div><a href="/foretagstjanster/" class="btn btn-outline">Alla tjänster</a></div>
    </div>
    <div class="grid" style="flex:2 1 560px;min-width:0">
      {services.map((s) => <ServiceCard s={s} />)}
    </div>
  </section>

  <!-- Mer att läsa -->
  {more.length > 0 && (
    <section class="soft">
      <div class="wrap section">
        <div class="section-head">
          <h2 class="h2">Mer att läsa</h2>
          <a href="/artiklar/" style="font-weight:600">Alla artiklar →</a>
        </div>
        <div class="grid">
          {more.map((p) => <ArticleCard post={p} showIngress />)}
        </div>
      </div>
    </section>
  )}

  <!-- Bli uppringd -->
  <section class="wrap section" id="bli-uppringd">
    <div class="callback">
      <div class="stack" style="gap:10px">
        <span class="eyebrow" style="color:var(--green)">{T.uppringd_etikett}</span>
        <h2 class="h2" style="color:#fff;margin:0">{T.uppringd_rubrik}</h2>
        <p style="margin:0;max-width:560px">{T.uppringd_text}</p>
        <div><button type="button" class="btn btn-bright" id="cb-open" aria-expanded="false" aria-controls="cb-form" data-umami-event="Bli uppringd (öppna)">{T.uppringd_knapp}</button></div>
      </div>
      <form class="form callback-form" id="cb-form" name="bli-uppringd" method="POST" action="/tack/" data-netlify="true" netlify-honeypot="bot-field" hidden>
        <input type="hidden" name="form-name" value="bli-uppringd" />
        <p hidden><label>Lämna tomt <input name="bot-field" /></label></p>
        <label>Namn<input name="namn" required autocomplete="name" /></label>
        <label>Telefon<input type="tel" name="telefon" required autocomplete="tel" /></label>
        <label>E-post<input type="email" name="email" autocomplete="email" /></label>
        <label>Företag (om du har)<input name="foretag" autocomplete="organization" /></label>
        <label>Vad behöver du hjälp med?<textarea name="behov" required></textarea></label>
        <div><button type="submit" class="btn btn-bright" data-umami-event="Bli uppringd (skickad)">Skicka</button></div>
      </form>
    </div>
  </section>

  <Newsletter />
</Base>

<script>
  const btn = document.getElementById('cb-open');
  const form = document.getElementById('cb-form');
  btn?.addEventListener('click', () => {
    if (!form) return;
    form.hidden = !form.hidden;
    btn.setAttribute('aria-expanded', String(!form.hidden));
    if (!form.hidden) (form.querySelector('input[name=namn]') as HTMLInputElement | null)?.focus();
  });
</script>
