---
import Base from '../layouts/Base.astro';
import { LAN } from '../config';
---
<Base title="Lista ditt företag" description="Skicka in ditt företag och synas på Nyföretagare.">
  <div class="wrap page-head stack">
    <span class="eyebrow">Gratis</span>
    <h1>Lista ditt företag</h1>
    <p class="lead" style="margin:0">Vill du ha en egen profil? <a href="/foretag/konto/">Skapa ett gratis företagskonto</a> – då styr du själv vad som syns. Vill du i stället tipsa om ett företag eller bli intervjuad, fyll i formuläret.</p>
  </div>
  <div class="wrap" style="padding-bottom:64px">
    <form class="form" name="lista-foretag" method="POST" action="/tack/" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="lista-foretag" />
      <p hidden><label>Lämna tomt <input name="bot-field" /></label></p>
      <label>Företagsnamn
        <input name="foretag" required autocomplete="organization" />
      </label>
      <label>Ditt namn
        <input name="namn" required autocomplete="name" />
      </label>
      <label>E-post
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>Telefon <span class="hint">(valfritt)</span>
        <input type="tel" name="telefon" autocomplete="tel" />
      </label>
      <label>Län
        <select name="lan" required>
          <option value="">Välj län</option>
          {LAN.map((l) => <option value={l.name}>{l.name}</option>)}
        </select>
      </label>
      <label>Ort / kommun
        <input name="ort" required />
      </label>
      <label>Bransch
        <input name="bransch" required placeholder="t.ex. café, bygg, redovisning" />
      </label>
      <label>Vad vill du?
        <select name="typ">
          <option>Synas som företag</option>
          <option>Listas som tjänsteleverantör</option>
          <option>Bli intervjuad i ett reportage</option>
          <option>Annonsera</option>
        </select>
      </label>
      <label>Hemsida eller sociala medier <span class="hint">(valfritt)</span>
        <input name="lank" placeholder="https://" />
      </label>
      <label>Berätta kort om företaget
        <textarea name="beskrivning" required></textarea>
      </label>
      <label style="display:flex;gap:10px;align-items:flex-start;font-weight:400">
        <input type="checkbox" name="samtycke" required style="margin-top:4px" />
        <span>Jag godkänner att Nyföretagare sparar uppgifterna för att kontakta mig. <a href="/integritet/">Läs mer</a>.</span>
      </label>
      <div><button type="submit" class="btn btn-primary">Skicka</button></div>
    </form>
  </div>
</Base>
