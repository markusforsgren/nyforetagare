---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, inCategory } from '../../lib/posts';
import { CATEGORIES } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: { name: c.name, posts: posts.filter((p) => inCategory(p, c.slug)) },
  }));
}
const { name, posts } = Astro.props;
const { slug } = Astro.params;
---
<Base title={name}>
  <div class="wrap page-head">
    <span class="eyebrow">Kategori</span>
    <h1>{name}</h1>
  </div>
  {slug === 'investering' && (
    <section class="wrap" style="padding-bottom:32px" id="investmatch">
      <div class="card dark investmatch">
        <span class="eyebrow" style="color:var(--green)">InvestMatch · Egen webbplats lanseras snart</span>
        <h2 class="h2" style="color:#fff;margin:0">Vi sammanför företag som söker kapital med investerare</h2>
        <p style="margin:0;max-width:720px">InvestMatch är vår matchningstjänst för entreprenörer och företag som behöver kapital för att växa – och för privatpersoner, affärsänglar och bolag som vill investera i nya företag. Tjänsten får en egen webbplats, investmatch.se. Anmäl intresse redan nu så hör vi av oss.</p>
        <div class="im-grid">
          <div class="im-box">
            <h3>Söker du kapital?</h3>
            <p>Berätta kort om företaget, hur mycket kapital ni söker och vad det ska användas till.</p>
            <a href="mailto:ir@investmatch.se?subject=S%C3%B6ker%20kapital%20%E2%80%93%20InvestMatch" class="btn btn-bright" data-umami-event="InvestMatch: Sök kapital">Sök kapital</a>
          </div>
          <div class="im-box">
            <h3>Vill du investera?</h3>
            <p>Berätta vilka branscher och vilken storlek på investering du är intresserad av.</p>
            <a href="mailto:ir@investmatch.se?subject=Bli%20investerare%20%E2%80%93%20InvestMatch" class="btn btn-ghost" data-umami-event="InvestMatch: Bli investerare">Bli investerare</a>
          </div>
        </div>
        <p class="small" style="margin:0;opacity:.8">Kontakt: <a href="mailto:ir@investmatch.se" style="color:#fff">ir@investmatch.se</a></p>
      </div>
    </section>
  )}
  <div class="wrap" style="padding-bottom:64px">
    {posts.length > 0
      ? <div class="grid">{posts.map((p) => <ArticleCard post={p} showIngress />)}</div>
      : <p class="lead">{slug === 'investering' ? 'Artiklar om investeringar kommer snart.' : 'Här kommer det snart artiklar.'} <a href="/artiklar/">Se alla artiklar</a>.</p>}
  </div>
</Base>
