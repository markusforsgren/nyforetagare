---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, inCategory } from '../../lib/posts';
import { CATEGORIES } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: { name: c.name, posts: posts.filter((p) => inCategory(p, c.slug)) },
  }));
}
const { name, posts } = Astro.props;
const { slug } = Astro.params;
---
<Base title={name}>
  <div class="wrap page-head">
    <span class="eyebrow">Kategori</span>
    <h1>{name}</h1>
  </div>
  {slug === 'investering' && (
    <section class="wrap" style="padding-bottom:32px" id="investmatch">
      <div class="card dark investmatch">
        <span class="eyebrow" style="color:var(--green)">InvestMatch · Lanseras snart</span>
        <h2 class="h2" style="color:#fff;margin:0">Matchning mellan investerare och företag</h2>
        <p style="margin:0;max-width:680px">InvestMatch kopplar ihop företag som söker kapital med investerare som letar efter nya bolag. Tjänsten byggs just nu och lanseras på investmatch.se. Söker du kapital eller vill du investera? Anmäl intresse redan nu.</p>
        <div><a href="mailto:ir@investmatch.se?subject=Intresseanm%C3%A4lan%20InvestMatch" class="btn btn-bright">Mejla ir@investmatch.se</a></div>
      </div>
    </section>
  )}
  <div class="wrap" style="padding-bottom:64px">
    {posts.length > 0
      ? <div class="grid">{posts.map((p) => <ArticleCard post={p} showIngress />)}</div>
      : <p class="lead">{slug === 'investering' ? 'Artiklar om investeringar kommer snart.' : 'Här kommer det snart artiklar.'} <a href="/artiklar/">Se alla artiklar</a>.</p>}
  </div>
</Base>
