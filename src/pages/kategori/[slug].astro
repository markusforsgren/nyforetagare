---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts, inCategory } from '../../lib/posts';
import { CATEGORIES, TEXTER } from '../../config';
const IM = TEXTER.investmatch;
const SEO = TEXTER.kategorier as Record<string, { titel: string; text: string }>;

export async function getStaticPaths() {
  const posts = await getPosts();
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: { name: c.name, posts: posts.filter((p) => inCategory(p, c.slug)) },
  }));
}
const { name, posts } = Astro.props;
const { slug } = Astro.params;
const seo = SEO[slug!];
---
<Base title={seo?.titel ?? name} description={seo?.text}>
  <div class="wrap page-head stack">
    <span class="eyebrow">Kategori</span>
    <h1>{name}</h1>
    {seo && <p class="lead" style="margin:0;max-width:760px">{seo.text}</p>}
  </div>
  {slug === 'investering' && (
    <section class="wrap" style="padding-bottom:32px" id="investmatch">
      <div class="card dark investmatch">
        <span class="eyebrow" style="color:var(--green)">{IM.etikett}</span>
        <h2 class="h2" style="color:#fff;margin:0">{IM.rubrik}</h2>
        <p style="margin:0;max-width:720px">{IM.text}</p>
        <div class="im-grid">
          <div class="im-box">
            <h3>{IM.kapital_rubrik}</h3>
            <p>{IM.kapital_text}</p>
            <a href={`mailto:${IM.epost}?subject=${encodeURIComponent('Söker kapital – InvestMatch')}`} class="btn btn-bright" data-umami-event="InvestMatch: Sök kapital">Sök kapital</a>
          </div>
          <div class="im-box">
            <h3>{IM.investera_rubrik}</h3>
            <p>{IM.investera_text}</p>
            <a href={`mailto:${IM.epost}?subject=${encodeURIComponent('Bli investerare – InvestMatch')}`} class="btn btn-ghost" data-umami-event="InvestMatch: Bli investerare">Bli investerare</a>
          </div>
        </div>
        <p class="small" style="margin:0;opacity:.8">Kontakt: <a href={`mailto:${IM.epost}`} style="color:#fff">{IM.epost}</a></p>
      </div>
    </section>
  )}
  <div class="wrap" style="padding-bottom:64px">
    {posts.length > 0
      ? <div class="grid">{posts.map((p) => <ArticleCard post={p} showIngress />)}</div>
      : <p class="lead">{slug === 'investering' ? 'Artiklar om investeringar kommer snart.' : 'Här kommer det snart artiklar.'} <a href="/artiklar/">Se alla artiklar</a>.</p>}
  </div>
</Base>
