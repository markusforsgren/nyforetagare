---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getPosts, formatDate } from '../../lib/posts';
import { categoryName } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const { title, ingress, kategori, datum, skribent, bild } = post.data;
const related = posts.filter((p) => p.id !== post.id && p.data.kategori === kategori).slice(0, 3);
---
<Base title={title} description={ingress} image={bild}>
  <article class="article">
    <a href={`/kategori/${kategori}/`} class="tag">{categoryName(kategori)}</a>
    <h1>{title}</h1>
    <p class="lead" style="margin:0 0 12px">{ingress}</p>
    <p class="muted" style="margin:0">Av {skribent} · {formatDate(datum)}</p>
    {bild && <img class="cover" src={bild} alt="" />}
    <div class="prose">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="soft">
      <div class="wrap section">
        <h2 class="h2" style="margin-bottom:24px">Mer inom {categoryName(kategori)}</h2>
        <div class="grid">{related.map((p) => <ArticleCard post={p} />)}</div>
      </div>
    </section>
  )}
  <Newsletter />
</Base>
