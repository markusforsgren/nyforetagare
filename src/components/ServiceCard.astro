---
import type { SERVICES } from '../config';
interface Props { s: (typeof SERVICES)[number] }
const { s } = Astro.props;
---
<article class={`card ${s.utvald ? 'featured' : 'bordered'}`}>
  {s.utvald && <span class="badge">Utvald partner</span>}
  <h3>{s.name}</h3>
  <span class="meta">{s.category} · {s.area}</span>
  <p>{s.text}</p>
  {s.price && <p style="font-weight:700;color:var(--ink)">{s.price}</p>}
  {s.link && <a href={s.link} class={`btn push ${s.utvald ? 'btn-primary' : 'btn-outline'}`} rel="noopener">Begär offert</a>}
</article>
