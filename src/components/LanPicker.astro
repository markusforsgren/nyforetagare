---
import { LAN } from '../config';
import { KOMMUNER } from '../data/kommuner';
interface Props { current?: string; id?: string }
const { current = '', id = 'lan-val' } = Astro.props;
// Sökbara namn: alla län och alla kommuner -> län-slug
const options = [
  ...LAN.map((l) => ({ label: `${l.name} (län)`, slug: l.slug })),
  ...Object.entries(KOMMUNER).flatMap(([slug, ks]) => ks.map((k) => ({ label: k, slug, lan: LAN.find((l) => l.slug === slug)?.full }))),
].sort((a, b) => a.label.localeCompare(b.label, 'sv'));
const curName = LAN.find((l) => l.slug === current)?.name ?? '';
---
<form class="lan-picker" action="/lan/" method="get" data-lan-picker>
  <label for={id} class="sr-only">Sök kommun eller län</label>
  <input id={id} name="q" list={`${id}-list`} autocomplete="off" placeholder={curName ? 'Sök annan kommun eller län' : 'Sök din kommun eller ditt län'} />
  <datalist id={`${id}-list`}>
    {options.map((o) => <option value={o.label} data-slug={o.slug}>{'lan' in o && o.lan ? o.lan : ''}</option>)}
  </datalist>
  <button type="submit" class="btn btn-dark">Visa</button>
  <p class="lan-picker-msg" role="status" hidden></p>
</form>

<script>
  // Hittar kommunen/länet och går till länets sida
  const norm = (s: string) => s.toLocaleLowerCase('sv').replace(/\s*\(län\)\s*$/, '').replace(/s? kommun$/, '').replace(/s? län$/, '').trim();
  document.querySelectorAll<HTMLFormElement>('[data-lan-picker]').forEach((form) => {
    const input = form.querySelector('input') as HTMLInputElement;
    const msg = form.querySelector('.lan-picker-msg') as HTMLElement;
    const opts = Array.from(form.querySelectorAll<HTMLOptionElement>('datalist option')).map((o) => ({ name: norm(o.value), label: o.value.replace(/\s*\(län\)$/, ''), slug: o.dataset.slug! }));
    const find = (q: string) => {
      const n = norm(q);
      if (!n) return null;
      return opts.find((o) => o.name === n) || opts.find((o) => o.name.startsWith(n)) || null;
    };
    const go = (e?: Event) => {
      e?.preventDefault();
      const hit = find(input.value);
      if (!hit) {
        msg.hidden = false;
        msg.textContent = input.value.trim() ? `Hittade ingen kommun som heter "${input.value.trim()}".` : 'Skriv namnet på din kommun eller ditt län.';
        return;
      }
      window.location.href = `/lan/${hit.slug}/?kommun=${encodeURIComponent(hit.label)}`;
    };
    form.addEventListener('submit', go);
    // Valt ur listan -> gå direkt
    input.addEventListener('change', () => { if (opts.some((o) => o.label === input.value.replace(/\s*\(län\)$/, ''))) go(); });
    input.addEventListener('input', () => { msg.hidden = true; });
  });
</script>
