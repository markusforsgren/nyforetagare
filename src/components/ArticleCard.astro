---
import type { CollectionEntry } from 'astro:content';
import { categoryName, lanName } from '../config';

interface Props {
  post: CollectionEntry<'artiklar'>;
  showIngress?: boolean;
}
const { post, showIngress = false } = Astro.props;
const { title, ingress, kategori, bild, lan } = post.data;
---
<a href={`/artiklar/${post.id}/`} class="acard">
  {bild ? (
    <img class="img" src={bild} alt="" loading="lazy" />
  ) : (
    <div class={`img img-fallback cat-${kategori}`} aria-hidden="true">
      <img src="/img/mark.png" alt="" width="44" height="42" />
      <span>{categoryName(kategori)}</span>
    </div>
  )}
  <span class="cat">{categoryName(kategori)}{lan && ` · ${lanName(lan)}`}</span>
  <span class="t">{title}</span>
  {showIngress && <p class="i">{ingress}</p>}
</a>
